{
  "cleanUrls": true,
  "rewrites": [{ "source": "/admin", "destination": "/admin.html" }],
  "redirects": [{ "source": "/admin.html", "destination": "/", "permanent": true }],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
